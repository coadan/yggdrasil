{
  "schema": "ygg.config/v1",
  "ignoreGlobs": [".ygg/config.json"],
  "maxFileBytes": 4194304,
  "plugins": [
    {
      "id": "jvm-dotnet",
      "version": "0.1.0",
      "command": ["plugins/jvm-dotnet/ygg-extract-jvm-dotnet"],
      "includeGlobs": ["**/*.java", "**/*.cs"],
      "timeoutMs": 10000
    }
  ]
}
