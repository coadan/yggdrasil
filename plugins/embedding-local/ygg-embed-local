#!/usr/bin/env python3
"""Serve a local Sentence Transformers model over ygg.embedding/v1."""

from __future__ import annotations

import hashlib
import json
import math
import os
import sys


SCHEMA = "ygg.embedding/v1"
DEFAULT_BATCH_SIZE = 64


def emit(value):
    sys.stdout.write(json.dumps(value, separators=(",", ":")) + "\n")
    sys.stdout.flush()


def configured_batch_size():
    raw = os.environ.get("YGG_LOCAL_EMBEDDING_BATCH_SIZE", str(DEFAULT_BATCH_SIZE))
    try:
        value = int(raw)
    except ValueError as error:
        raise ValueError("YGG_LOCAL_EMBEDDING_BATCH_SIZE must be a positive integer") from error
    if value <= 0:
        raise ValueError("YGG_LOCAL_EMBEDDING_BATCH_SIZE must be a positive integer")
    return value


def plain_vectors(encoded):
    if hasattr(encoded, "tolist"):
        encoded = encoded.tolist()
    return [[float(value) for value in row] for row in encoded]


class SentenceTransformerBackend:
    def __init__(self, model_name, dimensions):
        self.model_name = model_name
        self.dimensions = dimensions
        self.model = None

    def encode(self, texts):
        if self.model is None:
            try:
                from sentence_transformers import SentenceTransformer
            except ImportError as error:
                raise RuntimeError(
                    "sentence-transformers is not installed in the worker environment"
                ) from error
            self.model = SentenceTransformer(self.model_name)
        vectors = plain_vectors(
            self.model.encode(
                texts,
                batch_size=configured_batch_size(),
                normalize_embeddings=True,
                show_progress_bar=False,
            )
        )
        validate_vectors(vectors, len(texts), self.dimensions)
        return vectors


class DeterministicTestBackend:
    """Dependency-free protocol fixture. It is not a semantic embedding model."""

    def __init__(self, dimensions):
        self.dimensions = dimensions

    def encode(self, texts):
        vectors = []
        for text in texts:
            values = []
            counter = 0
            while len(values) < self.dimensions:
                digest = hashlib.sha256(
                    f"{counter}\0{text}".encode("utf-8")
                ).digest()
                values.extend((byte - 127.5) / 127.5 for byte in digest)
                counter += 1
            values = values[: self.dimensions]
            magnitude = math.sqrt(sum(value * value for value in values))
            vectors.append([value / magnitude for value in values])
        return vectors


def backend(model_name, dimensions):
    selected = os.environ.get("YGG_LOCAL_EMBEDDING_BACKEND", "sentence-transformers")
    if selected == "sentence-transformers":
        return SentenceTransformerBackend(model_name, dimensions)
    if selected == "deterministic-test":
        return DeterministicTestBackend(dimensions)
    raise ValueError(f"unsupported YGG_LOCAL_EMBEDDING_BACKEND {selected!r}")


def validate_vectors(vectors, expected_count, dimensions):
    if len(vectors) != expected_count:
        raise ValueError(
            f"model returned {len(vectors)} vectors, expected {expected_count}"
        )
    for index, vector in enumerate(vectors):
        if len(vector) != dimensions:
            raise ValueError(
                f"model vector {index} has {len(vector)} dimensions, expected {dimensions}"
            )


def validate_hello(message):
    if message.get("schema") != SCHEMA:
        raise ValueError(f"unsupported schema {message.get('schema')!r}")
    model_name = message.get("model")
    dimensions = message.get("dimensions")
    if not isinstance(model_name, str) or not model_name:
        raise ValueError("hello model must be a non-empty string")
    if not isinstance(dimensions, int) or isinstance(dimensions, bool) or dimensions <= 0:
        raise ValueError("hello dimensions must be a positive integer")
    return model_name, dimensions


def validate_inputs(message, expected_model):
    if message.get("model") != expected_model:
        raise ValueError("embed model does not match hello model")
    request_id = message.get("requestId")
    if not isinstance(request_id, str) or not request_id:
        raise ValueError("embed requestId must be a non-empty string")
    inputs = message.get("inputs")
    if not isinstance(inputs, list):
        raise ValueError("embed inputs must be an array")
    seen = set()
    for value in inputs:
        if not isinstance(value, dict):
            raise ValueError("each embed input must be an object")
        input_id = value.get("id")
        if not isinstance(input_id, str) or not input_id:
            raise ValueError("each embed input id must be a non-empty string")
        if input_id in seen:
            raise ValueError(f"duplicate embed input id {input_id!r}")
        seen.add(input_id)
        if not isinstance(value.get("text"), str):
            raise ValueError("each embed input text must be a string")
    return request_id, inputs


def serve(input_stream):
    model_name = None
    dimensions = None
    encoder = None
    batches = 0
    inputs_encoded = 0

    for raw in input_stream:
        message = json.loads(raw)
        message_type = message.get("type")
        if message_type == "hello":
            if model_name is not None:
                raise ValueError("hello may only be sent once")
            model_name, dimensions = validate_hello(message)
            encoder = backend(model_name, dimensions)
            emit({"type": "ready", "schema": SCHEMA})
        elif message_type == "embed":
            if encoder is None:
                raise ValueError("hello must be sent before embed")
            request_id, inputs = validate_inputs(message, model_name)
            vectors = (
                encoder.encode([value["text"] for value in inputs]) if inputs else []
            )
            validate_vectors(vectors, len(inputs), dimensions)
            values = [
                {"id": value["id"], "vector": vector}
                for value, vector in zip(inputs, vectors)
            ]
            batches += 1
            inputs_encoded += len(inputs)
            emit({"type": "result", "requestId": request_id, "values": values})
        elif message_type == "end":
            if encoder is None:
                raise ValueError("hello must be sent before end")
            emit({"type": "summary", "batches": batches, "inputs": inputs_encoded})
            return
        else:
            raise ValueError(f"unsupported message type {message_type!r}")


def main():
    try:
        serve(sys.stdin)
        return 0
    except Exception as error:
        sys.stderr.write(f"ygg-embed-local: {error}\n")
        return 3


if __name__ == "__main__":
    raise SystemExit(main())
