#!/usr/bin/env python3
"""Emit Python AST facts through the Yggdrasil extractor JSONL protocol."""

import ast
import json
import sys

SCHEMA = "ygg.extractor/v1"
MAX_FACTS = 256
MAX_STRUCTURAL_BYTES = 512 * 1024


def words(name):
    value = []
    current = []
    for character in name:
        if character in "_-":
            if current:
                value.append("".join(current).lower())
                current = []
        elif character.isupper() and current and current[-1].islower():
            value.append("".join(current).lower())
            current = [character]
        else:
            current.append(character)
    if current:
        value.append("".join(current).lower())
    return " ".join(value)


def record(kind, title, line, source, metadata=None, end_line=None, structural=False):
    lines = source.splitlines()
    end_line = max(line, end_line or line)
    text = "\n".join(lines[line - 1 : end_line]).strip() if 0 < line <= len(lines) else title
    metadata = dict(metadata or {})
    if structural:
        metadata["structural"] = True
    return {
        "id": f"{kind}:{line}:{title}",
        "startLine": line,
        "endLine": end_line,
        "kind": kind,
        "title": title,
        "text": f"{text}\n{words(title)}",
        **({"metadata": metadata} if metadata else {}),
    }


def navigation_record(filename, records):
    lines = [f"file {filename}", "kind python"]
    lines.extend(f'{item["kind"]} {item["title"]}' for item in records)
    return {
        "id": "python-navigation:1",
        "startLine": 1,
        "endLine": 1,
        "kind": "python-navigation",
        "title": filename,
        "text": "\n".join(lines),
        "metadata": {"facts": len(records), "lexical": False},
    }


def definition_records(kind, title, node, source, metadata=None):
    values = [record(kind, title, node.lineno, source, metadata)]
    end_line = getattr(node, "end_lineno", node.lineno)
    if end_line > node.lineno:
        values.append(
            record(
                "python-structural",
                title,
                node.lineno,
                source,
                {"ownerKind": kind},
                end_line,
                True,
            )
        )
        values[-1]["metadata"]["lexical"] = False
    return values


def import_targets(node):
    if isinstance(node, ast.Import):
        return [alias.name for alias in node.names]
    prefix = "." * node.level
    if node.module:
        return [prefix + node.module]
    return [prefix + alias.name for alias in node.names]


def extract(source, filename):
    try:
        tree = ast.parse(source, filename=filename)
    except SyntaxError as error:
        message = error.msg
        if error.lineno:
            message = f"line {error.lineno}: {message}"
        return [], [{"message": message}]

    facts = []
    structures = []

    def add_definition(values):
        facts.append(values[0])
        structures.extend(values[1:])

    for node in tree.body:
        if isinstance(node, (ast.Import, ast.ImportFrom)):
            for target in import_targets(node):
                if len(facts) < MAX_FACTS:
                    facts.append(record("python-import", target, node.lineno, source))
        elif isinstance(node, ast.ClassDef):
            add_definition(definition_records("python-class", node.name, node, source))
            for child in node.body:
                if len(facts) < MAX_FACTS and isinstance(child, (ast.FunctionDef, ast.AsyncFunctionDef)):
                    add_definition(
                        definition_records(
                            "python-method",
                            f"{node.name}.{child.name}",
                            child,
                            source,
                            {"async": isinstance(child, ast.AsyncFunctionDef)},
                        )
                    )
        elif isinstance(node, (ast.FunctionDef, ast.AsyncFunctionDef)):
            add_definition(
                definition_records(
                    "python-function",
                    node.name,
                    node,
                    source,
                    {"async": isinstance(node, ast.AsyncFunctionDef)},
                )
            )
        if len(facts) >= MAX_FACTS:
            break
    facts = facts[:MAX_FACTS]
    bounded_structures = []
    structural_bytes = 0
    for item in structures[:MAX_FACTS]:
        size = len(item["text"].encode("utf-8"))
        if structural_bytes + size <= MAX_STRUCTURAL_BYTES:
            bounded_structures.append(item)
            structural_bytes += size
    structures = bounded_structures
    records = facts + structures
    if facts:
        records.insert(0, navigation_record(filename, facts))
    return records, []


def emit(value):
    sys.stdout.write(json.dumps(value, separators=(",", ":")) + "\n")
    sys.stdout.flush()


def main():
    files = 0
    record_count = 0
    for raw in sys.stdin:
        value = json.loads(raw)
        message_type = value.get("type")
        if message_type == "hello":
            if value.get("schema") != SCHEMA:
                raise ValueError(f"unsupported schema {value.get('schema')!r}")
            emit({"type": "ready", "schema": SCHEMA})
        elif message_type == "file":
            file = value["file"]
            records, diagnostics = extract(file["content"], file["path"])
            files += 1
            record_count += len(records)
            emit(
                {
                    "type": "result",
                    "requestId": value["requestId"],
                    "records": records,
                    "diagnostics": diagnostics,
                }
            )
        elif message_type == "end":
            emit({"type": "summary", "files": files, "records": record_count})
            return
        else:
            raise ValueError(f"unsupported message type {message_type!r}")


if __name__ == "__main__":
    main()
