{
  "mode": "local",
  "branch": "main",
  "hooks": {
    "check": [
      {
        "name": "test",
        "command": [
          "go",
          "test",
          "./..."
        ]
      },
      {
        "name": "vet",
        "command": [
          "go",
          "vet",
          "./..."
        ]
      },
      {
        "name": "format",
        "command": [
          "sh",
          "-c",
          "test -z \"$(gofmt -l .)\""
        ]
      }
    ],
    "prepare": [
      {
        "name": "ygg-index",
        "command": [
          "sh",
          "-c",
          "command -v ygg >/dev/null 2>&1 || exit 0; ygg index --root . >/dev/null 2>&1 || true"
        ]
      }
    ]
  }
}
